# =====================================================================
# CareOS — environment variables (Phase 0)
# Copy to .env at repo root; values are read by docker compose + apps.
# Never commit secrets. All values below are placeholders.
# =====================================================================

# --- core ---
COMPOSE_PROJECT_NAME=careos
TZ=Europe/London
PUBLIC_HOSTNAME=localhost
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# --- postgres ---
POSTGRES_USER=careos
POSTGRES_PASSWORD=change-me
POSTGRES_APP_USER=careos_app
POSTGRES_APP_PASSWORD=change-me
POSTGRES_DB=careos
POSTGRES_PORT=5432
# additional databases created at init:
POSTGRES_EXTRA_DBS=keycloak,temporal,mattermost,novu

# --- redis ---
REDIS_PASSWORD=change-me

# --- keycloak ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_REALM=careos
KEYCLOAK_PORT=8080
KEYCLOAK_API_CLIENT_SECRET=change-me
KEYCLOAK_MCP_CLIENT_SECRET=change-me

# --- minio ---
# Optional integrations are disabled by default. Add `novu-optional` when
# needed locally; `mattermost-optional` is reviewed for linux/amd64 only.
COMPOSE_PROFILES=
MINIO_ROOT_USER=careos
MINIO_ROOT_PASSWORD=change-me
MINIO_BUCKETS=attachments exports ingest careos-documents careos-export-bundles
MINIO_DOCUMENTS_BUCKET=careos-documents
MINIO_EXPORT_BUNDLES_ENABLED=false
MINIO_EXPORT_BUNDLES_BUCKET=careos-export-bundles
MINIO_PUBLIC_ENDPOINT=https://localhost/minio
OBJECT_STORAGE_PROVIDER=minio

# --- docling ---
DOCLING_URL=http://docling-serve:5001

# --- export bundles ---
EXPORT_BUNDLE_SIGNING_KEY=change-me

# --- api ---
API_PORT=3000
API_JWT_AUDIENCE=api
NEXT_PUBLIC_API_BASE_URL=https://localhost/api
DATABASE_URL=postgresql://careos_app:change-me@postgres:5432/careos?schema=public
MIGRATION_DATABASE_URL=postgresql://careos:change-me@postgres:5432/careos?schema=public
API_PUBLIC_URL=https://localhost/api
API_INTERNAL_URL=http://api:3000
LOG_LEVEL=info
ENABLE_SWAGGER_UI=false

# --- temporal ---
TEMPORAL_HOST=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_DOCUMENTS_TASK_QUEUE=careos.documents
TEMPORAL_EXPORT_BUNDLES_TASK_QUEUE=careos.export-bundles
TEMPORAL_NOTIFICATIONS_TASK_QUEUE=careos.notifications
TEMPORAL_RETENTION_TASK_QUEUE=careos.retention
TEMPORAL_ROTA_TASK_QUEUE=careos.rota
TEMPORAL_TASK_QUEUE=careos.phase0
TEMPORAL_UI_PUBLIC_URL=https://localhost/temporal
AUTO_REGISTER_SCHEDULES=true

# --- workflow runtime ---
# Temporal remains the default and rollback runtime. Set individual families to
# `durable` only when the Durable Task scheduler is reachable.
DURABLE_TASK_SCHEDULER_CONNECTION_STRING=Endpoint=http://dts-emulator:8080;Authentication=None;TaskHub=default
WORKFLOW_RUNTIME_APPROVALS=temporal
WORKFLOW_RUNTIME_DOCUMENTS=temporal
WORKFLOW_RUNTIME_EMAIL_DRAFTS=temporal
WORKFLOW_RUNTIME_EXPORT_BUNDLES=temporal
WORKFLOW_RUNTIME_HANDOVER_DUE_REMINDERS=temporal
WORKFLOW_RUNTIME_HANDOVERS=temporal
WORKFLOW_RUNTIME_INCIDENTS=temporal
WORKFLOW_RUNTIME_MISSING_FIELDS_AUDIT=temporal
WORKFLOW_RUNTIME_PING=temporal
WORKFLOW_RUNTIME_RETENTION=temporal
WORKFLOW_RUNTIME_ROTA_ANALYZE=temporal
WORKFLOW_RUNTIME_ROTA_PUBLISH=temporal
WORKFLOW_RUNTIME_SAFEGUARDING_DIGEST=temporal
WORKFLOW_RUNTIME_SHIFT_REMINDERS=temporal

# --- bootstrap ---
# One-shot compose jobs: `migrate` always runs prisma migrate deploy with
# MIGRATION_DATABASE_URL; `seed-demo` upserts deterministic demo identities
# (apps/api/prisma/seed-data.json) ONLY when CAREOS_SEED_DEMO=true.
# Keep false in production.
CAREOS_SEED_DEMO=true

# --- hermes / llm gateway ---
# The gateway defaults to local Ollama. Azure adapters are opt-in.
LLM_GATEWAY_URL=http://llm-gateway:8080
LLM_GATEWAY_SERVICE_TOKEN=change-me
LLM_GATEWAY_MONTHLY_TOKEN_BUDGET=1000000
CAREOS_LLM_PROVIDER=ollama
CAREOS_LLM_MODEL=qwen2.5:0.5b-instruct
OLLAMA_MODEL_MANIFEST_DIGEST=sha256:a8b0c51577010a279d933d14c2a8ab4b268079d44c5c8830c0a93900f1827c67
OLLAMA_URL=http://ollama:11434
# Set COMPOSE_PROFILES=llm to start Ollama and pull the pinned model for live evals.
OLLAMA_KEEP_ALIVE=10m
AZURE_OPENAI_ENDPOINT=https://example.openai.azure.com
AZURE_OPENAI_API_KEY=change-me
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21
# optional: Foundry inference endpoint for open-weights deployments
AZURE_AI_INFERENCE_ENDPOINT=
AZURE_AI_INFERENCE_KEY=

# --- observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
NEXT_PUBLIC_OTEL_EXPORTER_OTLP_ENDPOINT=https://localhost/otel/v1/traces
OTEL_SERVICE_NAMESPACE=careos
OTEL_SDK_DISABLED=false
NEXT_PUBLIC_OTEL_SDK_DISABLED=false
SENTRY_DSN=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# --- novu ---
NOVU_API_KEY=change-me
NOVU_JWT_SECRET=change-me
NOVU_STORE_ENCRYPTION_KEY=change-me-32-byte-placeholder

# --- mattermost ---
MATTERMOST_PORT=8065
MATTERMOST_URL=
MATTERMOST_BOT_TOKEN=
# Shared secret presented only by the Mattermost bot when exchanging /link codes.
MATTERMOST_BOT_WEBHOOK_TOKEN=change-me

# --- web ---
WEB_PORT=3001
NEXTAUTH_SECRET=change-me
NEXTAUTH_URL=https://localhost
KEYCLOAK_ISSUER=https://localhost/keycloak/realms/careos
KEYCLOAK_INTERNAL_ISSUER=http://keycloak:8080/keycloak/realms/careos
KEYCLOAK_WEB_CLIENT_ID=web
KEYCLOAK_WEB_CLIENT_SECRET=
