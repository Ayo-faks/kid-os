{
  "name": "careos",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Kid-OS — multi-home residential child-care operations platform.",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "ci:compose-smoke": "scripts/compose-smoke.sh",
    "ci:durable-payloads": "node scripts/check-scheduler-payloads.mjs",
    "ci:openapi": "pnpm --filter @careos/api openapi && git diff --exit-code -- packages/contracts/openapi.yaml",
    "ci:open-source": "node scripts/check-open-source-readiness.mjs",
    "ci:open-source:public": "node scripts/check-open-source-readiness.mjs --mode public",
    "ci:open-source:release": "node scripts/check-open-source-readiness.mjs --mode release",
    "ci:prisma": "DATABASE_URL=${DATABASE_URL:-postgresql://careos_app:change-me@postgres:5432/careos?schema=public} pnpm --filter @careos/api exec prisma validate --schema prisma/schema.prisma",
    "ci:supply-chain": "node scripts/check-supply-chain-pins.mjs",
    "ci:supply-chain:live": "node scripts/check-supply-chain-live.mjs",
    "clean:generated": "rm -rf apps/*/dist packages/*/dist apps/web/.next apps/agent/careos_agent.egg-info && find . -name '*.tsbuildinfo' -not -path '*/node_modules/*' -delete",
    "test:agent": "PYTHONPATH=apps/agent python3 -m pytest apps/agent/tests -q",
    "test:e2e:real": "scripts/phase4-real-stack.sh",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "pnpm": {
    "overrides": {
      "@grpc/grpc-js@1.14.3": "1.14.4",
      "@hookform/resolvers": "^3.10.0",
      "@opentelemetry/propagator-jaeger@2.7.1": "2.10.0",
      "axios@1.16.1": "1.18.1",
      "fast-uri@2.4.0": "2.4.4",
      "fast-uri@3.1.2": "3.1.5",
      "fast-uri@3.1.4": "3.1.5",
      "fast-uri@4.1.1": "4.1.2",
      "find-my-way@9.6.0": "9.7.0",
      "form-data@4.0.5": "4.0.6",
      "js-yaml@4.1.0": "4.3.0",
      "js-yaml@5.2.1": "5.2.2",
      "lodash@4.17.21": "4.18.1",
      "nanoid@3.3.16": "3.3.17",
      "postcss@8.4.31": "8.5.23",
      "protobufjs@7.5.5": "7.6.1",
      "protobufjs@7.5.8": "7.6.1",
      "sharp@0.34.5": "0.35.3",
      "zod": "^3.23.8"
    }
  },
  "devDependencies": {
    "@azure/identity": "^4.13.0",
    "@careos/object-storage": "workspace:*",
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@eslint/js": "^9.12.0",
    "@types/node": "^22.7.4",
    "eslint": "^9.12.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "globals": "^15.10.0",
    "husky": "^9.1.6",
    "pg": "^8.20.0",
    "prettier": "^3.3.3",
    "turbo": "^2.10.12",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.8.0",
    "vitest": "^2.1.2"
  }
}
