{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://careos.local/schemas/note.observation.v1.json",
  "title": "Observation Note",
  "type": "object",
  "required": ["residentId", "observedAt", "body"],
  "properties": {
    "residentId": { "type": "string", "format": "uuid", "title": "Resident", "x-mandatory": true },
    "observedAt": {
      "type": "string",
      "format": "date-time",
      "title": "Observed at",
      "x-mandatory": true
    },
    "body": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "title": "Observation",
      "x-mandatory": true
    },
    "mood": {
      "type": "string",
      "enum": ["positive", "neutral", "low", "agitated", "withdrawn", "unknown"],
      "default": "unknown"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 40 },
      "default": []
    }
  },
  "additionalProperties": false
}
