{
  "extends": "@careos/tsconfig/base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "types": ["node", "@playwright/test"]
  },
  "include": [
    "global-setup.ts",
    "playwright.config.ts",
    "playwright.real.config.ts",
    "scripts/**/*.ts",
    "e2e/**/*.ts",
    "real-stack/**/*.ts"
  ],
  "exclude": ["node_modules", "playwright-report", "test-results"]
}
